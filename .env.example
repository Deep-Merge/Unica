# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# House API (local file store at .data/house.json until Supabase keys exist)
# Apply supabase/migrations/0001_foundation.sql + 0002_house_members.sql + supabase/seed.sql

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Calendly
CALENDLY_WEBHOOK_SIGNING_KEY=
NEXT_PUBLIC_CALENDLY_URL=

# Email — confirmation letters
# Free path: leave empty. Supabase sends confirmations itself (limited on the free plan).
# Gmail path: Authentication → SMTP in the Supabase dashboard.
#   host smtp.gmail.com / port 587 / your Gmail / a Google App Password
#   Possible and free for low volume. Not ideal for launch (spam, daily caps).
# Later: Resend free tier (~100/day) is cleaner than Gmail.
RESEND_API_KEY=
RESEND_FROM=Unica <hello@localhost>

# Errors
SENTRY_DSN=

# AI — Phase 8 only
# OPENAI_API_KEY=
